{
  "name": "@aaqiljamal/visual-editor-mcp",
  "version": "0.2.0",
  "description": "stdio MCP server for visual-editor — 8 tools for Claude Code / Cursor / Codex: read the user's browser selection + pins with source context, propose/apply/revert deterministic edits, highlight elements in the browser, resolve pins.",
  "type": "module",
  "bin": {
    "visual-editor-mcp": "bin/visual-editor-mcp.cjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node --import tsx src/server.ts",
    "test": "node --import tsx --test --test-timeout=20000 --test-reporter=spec test/smoke.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "visual-editor",
    "mcp",
    "claude-code"
  ],
  "license": "MIT",
  "author": "Aaqil Jamal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Design-Alchemist/visual-editor.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/The-Design-Alchemist/visual-editor#readme",
  "bugs": "https://github.com/The-Design-Alchemist/visual-editor/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aaqiljamal/visual-editor-server": "0.2.0",
    "@types/node": "^22.10.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
