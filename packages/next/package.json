{
  "name": "@aaqiljamal/visual-editor-next",
  "version": "0.3.0",
  "description": "Visual-edit for Next.js — one install. withVisualEditor() wires the SWC-compatible stamping loader + auto-mounts the overlay; a one-line Route Handler does AST writes inside your dev process.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "import": "./dist/route.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js",
      "require": "./dist/config.cjs"
    },
    "./client": {
      "default": "./dist/client.js"
    },
    "./loader": "./loader.cjs"
  },
  "bin": {
    "visual-editor-init": "bin/visual-editor-init.cjs"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "loader.cjs",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "visual-editor",
    "next",
    "tailwind",
    "css-modules",
    "styled-components"
  ],
  "license": "MIT",
  "author": "Aaqil Jamal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/The-Design-Alchemist/visual-editor.git",
    "directory": "packages/next"
  },
  "homepage": "https://github.com/The-Design-Alchemist/visual-editor#readme",
  "bugs": "https://github.com/The-Design-Alchemist/visual-editor/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "next": ">=15.0.0",
    "react": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@aaqiljamal/visual-editor-babel-plugin": "0.3.0",
    "@aaqiljamal/visual-editor-runtime": "0.3.0",
    "@aaqiljamal/visual-editor-server": "0.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3"
  }
}
